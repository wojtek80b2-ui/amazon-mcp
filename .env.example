# Skopiuj ten plik jako .env i uzupełnij. Plik .env NIGDY nie trafia do gita.

# Tryb pracy: "mock" = dane testowe (bez kluczy), "live" = prawdziwe SP-API.
AMAZON_MODE=mock

# --- Selling Partner API (Seller Central > Apps and Services > Develop Apps) ---
SP_API_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
SP_API_LWA_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=Atzr|xxxxxxxx
# Twoje Seller ID (Merchant Token) - potrzebne dla Listings API
SP_API_SELLER_ID=
# Domyślny marketplace: PL, DE, FR, IT, ES, NL, SE, BE, GB, US ...
SP_API_MARKETPLACE=PL

# --- Amazon Advertising API (osobne API, osobne klucze) ---
# Client ID/Secret z Security Profile (Login with Amazon). Refresh token i profil
# uzupełni: python -m amazon_mcp.ads_auth
ADS_API_CLIENT_ID=
ADS_API_CLIENT_SECRET=
ADS_API_REFRESH_TOKEN=
ADS_API_PROFILE_ID=
# Region Ads API: EU, NA, FE
ADS_API_REGION=EU

# Operacje zapisu (zmiana cen, listingi, raporty) wymagają confirm=true.
# Ustaw na "false", żeby całkowicie zablokować zapis.
AMAZON_ALLOW_WRITES=true
